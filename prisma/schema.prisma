generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum TransactionType {
  TRANSFER
  DEPOSIT
}

// ─── Models ──────────────────────────────────────────────────────────────────

/// Usuarios del sistema (clientes y administradores).
model User {
  id                  String   @id @default(uuid())
  email               String   @unique           // RNF-09: UNIQUE + formato email
  passwordHash        String
  firstName           String
  lastName            String
  role                Role     @default(USER)
  isBlocked           Boolean  @default(false)   // RNF-01: bloqueo automático
  failedLoginAttempts Int      @default(0)       // RNF-01: contador de intentos
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  account            Account?
  auditUnlockActions AuditUnlock[] @relation("AdminUnlockActions")
  auditUnlockTargets AuditUnlock[] @relation("UserUnlockTargets")
}

/// Cuenta bancaria asociada 1-a-1 con un usuario de rol USER.
model Account {
  id            String   @id @default(uuid())
  userId        String   @unique
  accountNumber String   @unique @db.Char(16)           // RNF-10: exactamente 16 dígitos
  balance       Decimal  @default(0.00) @db.Decimal(12, 2) // RNF-08: NUMERIC(12,2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user                 User          @relation(fields: [userId], references: [id])
  sentTransactions     Transaction[] @relation("FromAccount")
  receivedTransactions Transaction[] @relation("ToAccount")
}

/// Registro inmutable de cada movimiento financiero.
/// fromAccountId es null en DEPOSITs (crédito inicial, sin remitente).
model Transaction {
  id            String          @id @default(uuid())
  fromAccountId String?
  toAccountId   String
  amount        Decimal         @db.Decimal(12, 2) // RNF-08
  concept       String
  type          TransactionType
  createdAt     DateTime        @default(now())

  fromAccount Account?  @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccount   Account   @relation("ToAccount", fields: [toAccountId], references: [id])
}

/// Bitácora de auditoría de desbloqueos administrativos (RF-14).
model AuditUnlock {
  id           String   @id @default(uuid())
  adminId      String
  targetUserId String
  unlockedAt   DateTime @default(now())

  admin      User @relation("AdminUnlockActions", fields: [adminId], references: [id])
  targetUser User @relation("UserUnlockTargets", fields: [targetUserId], references: [id])
}

/// Tokens JWT revocados por logout (BU-7).
/// El middleware verifyJWT rechaza tokens cuyo jti esté en esta tabla.
model RevokedToken {
  jti       String   @id
  revokedAt DateTime @default(now())
}
